# ─────────────────────────────────────────────────────────────────────────────
# HunterIntel configuration.  Copy to `.env` (never commit the real file).
# Everything is optional — the platform runs with no keys using public DNS,
# RDAP, certificate transparency and local analysis.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
HUNTERINTEL_ENVIRONMENT=development
# SQLite for local use; PostgreSQL for Docker/production, e.g.
# HUNTERINTEL_DATABASE_URL=postgresql+asyncpg://hunterintel:change-me@postgres:5432/hunterintel
HUNTERINTEL_DATABASE_URL=sqlite+aiosqlite:///./hunterintel.db
# true = create tables on start (dev). Use `alembic upgrade head` + false in production.
HUNTERINTEL_AUTO_CREATE_SCHEMA=true
# Redis gives shared rate limiting + response cache across workers. Optional.
# HUNTERINTEL_REDIS_URL=redis://redis:6379/0

# Require 'Authorization: Bearer <token>' on every API call (recommended whenever
# the API is reachable by anyone but you).  Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
# HUNTERINTEL_API_TOKEN=

HUNTERINTEL_CORS_ORIGINS=http://localhost:5173

# ── Outbound safety ──────────────────────────────────────────────────────────
HUNTERINTEL_HTTP_TIMEOUT_SECONDS=12
HUNTERINTEL_MAX_RESPONSE_BYTES=2097152
# Per-provider rate-limit overrides: name=requests/seconds,...
# HUNTERINTEL_PROVIDER_RATE_LIMITS=virustotal=4/60,crtsh=1/3
HUNTERINTEL_DNS_RESOLVERS=1.1.1.1,9.9.9.9

# ── Privacy / active behaviour ───────────────────────────────────────────────
# Highest provider tier pre-selected in a query plan: local | public | third_party
# 'public' (default) never pre-selects keyed vendors; the analyst must tick them.
HUNTERINTEL_DEFAULT_SHARING=public
# Opt-in redirect-chain probe (one bounded, SSRF-guarded request per hop).
HUNTERINTEL_ALLOW_ACTIVE_PROBES=false
# Optional MaxMind-format database you provide (GeoLite2-City.mmdb, DB-IP lite, …)
# HUNTERINTEL_GEOIP_DB_PATH=/data/GeoLite2-City.mmdb

# ── Provider API keys (all optional) ─────────────────────────────────────────
# VirusTotal: https://www.virustotal.com/gui/my-apikey  (public API: 4 req/min, non-commercial)
VIRUSTOTAL_API_KEY=
# AbuseIPDB: https://www.abuseipdb.com/account/api  (free: 1000 checks/day)
ABUSEIPDB_API_KEY=
# AlienVault OTX: https://otx.alienvault.com/settings
OTX_API_KEY=
# abuse.ch (URLhaus + MalwareBazaar share one free Auth-Key): https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# ── Docker Compose only ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-before-exposing-this-anywhere
